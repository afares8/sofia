SOFIA_HOST=0.0.0.0
SOFIA_PORT=5180
SOFIA_CONFIG_PATH=data/config.json
SOFIA_DB_PATH=data/sofia.db
SOFIA_CODEX_MODEL=glm-5.2

# SMTP fallback email alerts (used when WhatsApp/WPPConnect is down).
# These mirror Mayor's MAIL_* credentials so the same Gmail app-password works.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Sofia Monitor
# Comma-separated list of recipients for fallback alerts.
SOFIA_ALERT_EMAIL=ahmed@magnate-inc.com,order@magnate-inc.com


# Droplet docker monitor (SSH scrape of docker logs/events, no agent needed)
SOFIA_DROPLET_MONITOR=true
SOFIA_DROPLET_HOST=198.211.99.4
SOFIA_DROPLET_USER=root
SOFIA_DROPLET_KEY=C:\Users\ahmed\.ssh\id_ed25519
SOFIA_DROPLET_POLL_S=120


# Local host monitor (SERVER-SOFIA: disk/mem/CPU, services, Event Log, cert)
SOFIA_LOCAL_MONITOR=true
SOFIA_LOCAL_POLL_S=120
SOFIA_LOCAL_DISK_WARN=85
SOFIA_LOCAL_DISK_CRIT=93
SOFIA_LOCAL_MEM_WARN=10
SOFIA_LOCAL_CPU_WARN=95
